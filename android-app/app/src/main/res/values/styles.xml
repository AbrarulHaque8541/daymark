<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#16705F</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="AppThemeLight" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#16705F</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="AppThemeDark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#7ACCB2</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="DaymarkSplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/daymark_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <!-- Keep the established title and creator line without reintroducing a splash activity UI. -->
        <item name="windowSplashScreenBrandingImage">@drawable/daymark_splash_branding</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>

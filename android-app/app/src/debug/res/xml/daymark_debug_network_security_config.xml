<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Preserve the existing HTTP browser behavior in debug builds. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Test-only CA trust is limited to the loopback HTTPS fixture. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/daymark_test_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
